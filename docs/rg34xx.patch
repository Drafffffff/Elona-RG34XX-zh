+
+// Return a whole UTF-8 prefix and its display width. A zero result means the
+// caller must start a new line; it must never retry with the same remaining room.
+inline std::pair<size_t, size_t> message_prefix(
+    const std::string& text, size_t available_width)
+{
+    size_t bytes = 0, width = 0;
+    while (bytes < text.size() && text[bytes] != '\n')
+    {
+        const auto count = std::min(byte_count(text[bytes]), text.size() - bytes);
+        const size_t char_width = count == 1 ? 1 : 2;
+        if (width + char_width > available_width) break;
+        bytes += count;
+        width += char_width;
+    }
+    return {bytes, width};
 }
 
 
