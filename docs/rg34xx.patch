--- a/runtime/mod/core/i18n/functions.lua
+++ b/runtime/mod/core/i18n/functions.lua
@@ -376,15 +376,56 @@
 -- Function registration.
 --
 
+-- Chinese must also localize generated pronouns and grammatical fragments.
+-- Otherwise translated sentences still contain words such as "his" and "you".
+i18n.zh_CN = {}
+
+local function chinese_pronoun(chara, ignore_sight)
+   if not chara then return "它" end
+   if chara.index == 0 then return "你" end
+   if chara.index < 0 or chara.index >= 245 then return "它" end
+   if not ignore_sight and not FOV.you_see(chara) then return "它" end
+   if chara.sex == "male" then return "他" end
+   if chara.sex == "female" then return "她" end
+   return "它"
+end
+
+i18n.zh_CN.he = chinese_pronoun
+i18n.zh_CN.him = chinese_pronoun
+function i18n.zh_CN.his(chara, ignore_sight)
+   return chinese_pronoun(chara, ignore_sight) .. "的"
+end
+function i18n.zh_CN.himself(chara)
+   return chinese_pronoun(chara) .. "自己"
+end
+function i18n.zh_CN.his_owned() return "的" end
+function i18n.zh_CN.ordinal(n) return tostring(n) end
+function i18n.zh_CN.capitalize(str) return str end
+function i18n.zh_CN.trim_job(name_with_job)
+   return (string.gsub(name_with_job, " .*", ""))
+end
+function i18n.zh_CN.name_nojob(chara)
+   return i18n.zh_CN.trim_job(chara.basename)
+end
+function i18n.zh_CN.is() return "" end
+function i18n.zh_CN.s() return "" end
+function i18n.zh_CN.does() return "" end
+function i18n.zh_CN.have() return "" end
+
 for name, func in pairs(i18n.en) do
    I18N.register_function("en", name, func)
 end
 
 for name, func in pairs(i18n.jp) do
    I18N.register_function("jp", name, func)
+end
+
+for name, func in pairs(i18n.zh_CN) do
+   I18N.register_function("zh_CN", name, func)
 end
 
 for name, func in pairs(i18n.all) do
    I18N.register_function("en", name, func)
    I18N.register_function("jp", name, func)
-end
