@@ -1046,6 +1046,43 @@
 /**
  * Draws text with a shadow.
  */
+void mes_centered(int x, int center_y, const std::string& text,
+                  const snail::Color& color)
+{
+    auto& renderer = snail::Application::instance().get_renderer();
+    auto selected_font = renderer.font();
+    auto* ttf = selected_font.ptr();
+    int top = 0, bottom = 0;
+    bool has_ink = false;
+    for (size_t i = 0; i < text.size();)
+    {
+        const auto first = static_cast<unsigned char>(text[i++]);
+        unsigned int code = first;
+        int continuation = 0;
+        if ((first & 0xe0) == 0xc0) { code = first & 0x1f; continuation = 1; }
+        else if ((first & 0xf0) == 0xe0) { code = first & 0x0f; continuation = 2; }
+        else if ((first & 0xf8) == 0xf0) { code = first & 7; continuation = 3; }
+        while (continuation-- > 0 && i < text.size())
+            code = (code << 6) | (static_cast<unsigned char>(text[i++]) & 0x3f);
+        if (code == ' ' || code > 0xffff) continue;
+        int min_x, max_x, min_y, max_y, advance;
+        if (TTF_GlyphMetrics(ttf, static_cast<Uint16>(code),
+                             &min_x, &max_x, &min_y, &max_y, &advance) == 0)
+        {
+            top = has_ink ? std::max(top, max_y) : max_y;
+            bottom = has_ink ? std::min(bottom, min_y) : min_y;
+            has_ink = true;
+        }
+    }
+    const auto previous_baseline = renderer.text_baseline();
+    renderer.set_text_baseline(snail::Renderer::TextBaseline::top);
+    const int offset = has_ink ? TTF_FontAscent(ttf) - (top + bottom) / 2
+                               : TTF_FontHeight(ttf) / 2;
+    renderer.render_text(text, x, center_y - offset, color);
+    renderer.set_text_baseline(previous_baseline);
+}
+
