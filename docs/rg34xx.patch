+
+                  give = {
+                     dialog = "Oh, thank you. You have a very kind heart, you know. The potion, I feel like the medicine is working better during the festival. Maybe it's the blessing of St.Jure?",
+                     you_hand_her = "You hand her a potion.",
+                  },
