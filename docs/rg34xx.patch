+void apply_world_transform(SDL_Renderer* r,SDL_Texture* target) {
+ if(!enabled()) return;
+ SDL_RenderSetClipRect(r,nullptr);
+ // SDL_SetRenderTarget restores its previous scale. Set the viewport while
+ // scale is 1 so repeated texture switches cannot enlarge the clipping area.
+ SDL_RenderSetScale(r,1,1);
+ if(drawing_world && target && target==world_texture) {
+  SDL_Rect viewport{0,0,720,world_view_height};
+  SDL_RenderSetViewport(r,&viewport);
+  SDL_RenderSetScale(r,map_scale,map_scale);
+  SDL_Rect clip{0,0,int(720/map_scale),int(world_view_height/map_scale)};
+  SDL_RenderSetClipRect(r,&clip);
+ } else {
+  SDL_RenderSetViewport(r,nullptr);
+  SDL_RenderSetScale(r,1,1);
+ }
+}
+MapScope::MapScope(SDL_Renderer* renderer,bool active)
+ : renderer_(renderer),previous_(drawing_world) {
+ if(enabled()) {drawing_world=active;apply_world_transform(renderer_,SDL_GetRenderTarget(renderer_));}
+}
+MapScope::~MapScope() {
+ if(enabled()) {drawing_world=previous_;apply_world_transform(renderer_,SDL_GetRenderTarget(renderer_));}
+}
+void frame(SDL_Renderer* r,SDL_Texture* texture) {
+ int tw=0,th=0;SDL_QueryTexture(texture,nullptr,nullptr,&tw,&th);
+ SDL_Rect src=scene_view;
+ src.x=std::min(src.x,std::max(0,tw-1));src.y=std::min(src.y,std::max(0,th-1));
+ src.w=std::min(src.w,tw-src.x);src.h=std::min(src.h,th-src.y);
+ const int available_height=show_hints?460:480;
+ const double scale=std::min(1.35,std::min(720.0/src.w,double(available_height)/src.h));
+ SDL_Rect dst{0,0,int(src.w*scale),int(src.h*scale)};
+ dst.x=(720-dst.w)/2;dst.y=(available_height-dst.h)/2;
+ // Fill the native gameplay viewport; retain every row of the source scene.
+ // With hints visible this is only a 4.2% vertical compression.
+ if(src.x==0 && src.y==0 && src.w==720 && src.h==480)
+  dst={0,0,720,available_height};
+ SDL_RenderSetLogicalSize(r,720,480);
+ SDL_SetTextureScaleMode(texture,SDL_ScaleModeLinear);
+ SDL_SetTextureBlendMode(texture,SDL_BLENDMODE_NONE);
+ SDL_RenderCopy(r,texture,&src,&dst);
+}
