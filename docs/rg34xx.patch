+-- Simplified Chinese, authored for the RG34XX port. Untranslated values retain English.
+ELONA.i18n:add {
+   class = {
+      unemployed = "无业",
+   },
+}
+
+
+
+ELONA.i18n:add_data_text(
+   "core.class",
+   {
+      warrior = {
+         name = "战士",
+         description = "战士精通各种近战与远程武器，手中的任何东西都能成为敌人的噩梦。他们熟悉战术，能击倒强敌，并从小训练如何使用各类盔甲和盾牌。他们相信：如果暴力解决不了问题，那只是用得还不够。",
+      },
+      thief = {
+         name = "盗贼",
+         description = "盗贼善用刀剑与弓，却不信奉公平决斗。他们尽量避免挨打，武器不太重时还能使用双刀流。与黑市商人的往来让他们擅长交涉。信条是：你的就是我的，我的还是我的。",
+      },
+      wizard = {
+         name = "魔法师",
+         description = "魔法师潜心钻研奥秘，因而疏于锻炼体魄和反应。不过，他们也略通杖与短剑。初出茅庐时虽然弱小，经过读书与练习，便能以魔法扫平千军。他们的格言是：还没着火的东西，很快就会着火。",
+      },
+      farmer = {
+         name = "农民",
+         description = "农民没有战士的体魄或法师的学识，却是实用技能的多面手。农活让他们善用长柄武器，与商人的交易让他们善于议价，各种手艺也都略知一二。只要有人愿意付钱，他们就不会挨饿。凡事亲力亲为，是他们的信条。",
+      },
+      predator = {
+         name = "掠食者",
+      },
+      archer = {
+         name = "猎人",
+         description = "猎人精通森林生活与狩猎，是出色的射手。在他们眼中，猎杀怪物和猎鹿没有多少区别。他们擅长短剑、斧与各种弓，也在漫长的林间旅途中学会了实用技能。倒在远处的敌人，自然无法威胁近处的自己。",
+      },
+      warmage = {
+         name = "魔法战士",
+         description = "魔法战士兼修武艺与法术，相信先点燃敌人再刺上一剑，比只做其中一件更有效。他们善用刀剑、盔甲，也能读书施法。广而不精是他们的弱点，但在他们看来，值得做的事就值得做过头。",
+      },
+      tourist = {
+         name = "观光客",
+         description = "观光客既没有特别的长处，也没有明显的短处，几乎一切都要从头学起；倒是还会钓鱼。若你喜欢白手起家的挑战，并愿意投入很多时间，这个职业很适合你。连格言都可以由你自己决定。",
+      },
+      pianist = {
+         name = "钢琴家",
+         description = "钢琴家擅长读书、演奏和制作首饰。虽然许多技艺看起来不太实用，但为了随身搬运钢琴，他们也练就了出色的举重能力。他们坚信：整个世界都是我的舞台！",
+      },
+      gunner = {
+         name = "枪手",
+      },
