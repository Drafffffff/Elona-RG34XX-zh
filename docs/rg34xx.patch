+// SPDX-License-Identifier: MIT
+// Native RG34XX input and display overlay. No input grab and no frontend signals.
+#include "handheld.hpp"
+#include <SDL_ttf.h>
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <string>
+#include <vector>
+#ifdef __linux__
+#include <fcntl.h>
+#include <linux/input.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#endif
+
+namespace elona { namespace snail { namespace handheld {
+namespace {
+enum Button { Up, Down, Left, Right, A, B, X, Y, L, R, Select, Start, Menu, L2, R2, Count };
+enum Panel { Closed, Actions, Keyboard, Help, Reading };
+std::array<bool, Count> held{};
+std::array<Uint32, Count> repeat_at{};
+std::deque<Button> pending;
+std::deque<std::string> selected;
+std::vector<Command> entries;
+std::vector<int> visible;
+std::vector<int> devices;
+SDL_Joystick* joystick = nullptr;
+Panel panel = Closed;
+bool menu_context = true;
+bool show_hints = true;
+bool drawing_world = false;
+SDL_Texture* world_texture = nullptr;
+int world_view_height = 312;
+std::string last_menu_direction;
+std::string queued_menu_direction;
+Uint32 menu_repeat_at = 0;
+bool text_mode = false;
+bool may_cancel = true;
+bool uppercase = false;
+bool l2_chord = false;
+int max_length = 24;
+std::string text_preview;
+int cursor = 0;
+TTF_Font* font = nullptr;
+TTF_Font* hint_font = nullptr;
+SDL_Rect scene_view{0,0,720,480};
+std::string context_hint;
+SDL_Texture* reading_frame = nullptr;
+int reading_w=720,reading_h=480,reading_x=0,reading_y=0,reading_view_h=224;
+std::vector<SDL_Keycode> release_next;
+constexpr int Columns = 10;
+const std::array<std::string,2> layouts={
+ "1234567890qwertyuiopasdfghjkl;zxcvbnm,./ -_?!@#$%&",
+ "`~!@#$%^&*()_+-=[]{}\\|;:'\",.<>/?0123456789 "};
+int keyboard_page=0;
+std::string letters=layouts[0];
+const std::map<int, Button> evdev = {
+ {103,Up},{108,Down},{105,Left},{106,Right},
+ {304,A},{305,B},{307,X},{306,Y},{308,L},{309,R},
+ {310,Select},{311,Start},{312,Menu},{314,L2},{315,R2}};
+const std::map<int, Button> sdlbuttons = {
+ {4,A},{3,B},{6,X},{5,Y},{7,L},{8,R},{9,Select},{10,Start},{11,Menu},{12,L2},{13,R2}};
+void key(SDL_Keycode code, bool down) {
+ SDL_Event e{}; e.type=down?SDL_KEYDOWN:SDL_KEYUP;
+ e.key.state=down?SDL_PRESSED:SDL_RELEASED;
+ e.key.keysym.sym=code; e.key.keysym.scancode=SDL_GetScancodeFromKey(code);
+ SDL_PushEvent(&e);
+}
+void tap(SDL_Keycode code) { key(code,true); release_next.push_back(code); }
+void emit_text(const std::string& value) {
+ SDL_Event e{}; e.type=SDL_TEXTINPUT;
+ SDL_strlcpy(e.text.text,value.c_str(),sizeof(e.text.text)); SDL_PushEvent(&e);
+}
+SDL_Keycode direction(Button b) {
+ switch(b) {case Up:return SDLK_UP;case Down:return SDLK_DOWN;case Left:return SDLK_LEFT;case Right:return SDLK_RIGHT;default:return 0;}
+}
+void stop_directions() { last_menu_direction.clear();queued_menu_direction.clear();for(int i=Up;i<=Right;++i) key(direction(static_cast<Button>(i)),false); }
+std::string held_direction() {
+ std::string move;
+ if(held[Up] && !held[Down]) move="north";
+ if(held[Down] && !held[Up]) move="south";
+ if(held[Left] && !held[Right]) move+="west";
+ if(held[Right] && !held[Left]) move+="east";
+ return move;
+}
+void close_panel() { panel=Closed; stop_directions(); if(reading_frame) {SDL_DestroyTexture(reading_frame);reading_frame=nullptr;} }
+void show(Panel p) {
+ stop_directions(); pending.clear(); panel=p; cursor=0;
+ visible.clear();
+ if(p==Actions) for(size_t i=0;i<entries.size();++i) if(entries[i].menu==menu_context) visible.push_back(int(i));
+}
+void accept_key() {
+ if(cursor<int(letters.size())) {
+  char c=letters[size_t(cursor)];
+  if(uppercase && c>='a' && c<='z') c=char(c-'a'+'A');
+  if(!text_mode || int(text_preview.size())<max_length) {
+   emit_text(std::string(1,c)); text_preview+=c;
+   if(!text_mode) { tap(SDL_GetKeyFromName(std::string(1,c).c_str())); close_panel(); }
+  }
+ } else {
+  const int special=cursor-int(letters.size());
+  if(special==0) { tap(SDLK_BACKSPACE); if(!text_preview.empty()) text_preview.pop_back(); }
+  if(special==1) uppercase=!uppercase;
+  if(special==2) { tap(SDLK_RETURN); close_panel(); }
+  if(special==3 && (!text_mode || may_cancel)) { tap(SDLK_ESCAPE); close_panel(); }
+ }
+}
+void press(Button b) {
+ if(b==X && held[Menu] && (panel==Help || panel==Closed)) {
+  show_hints=!show_hints;pending.clear();close_panel();return;
+ }
+ if(b==R && held[Menu] && (panel==Help || panel==Closed)) {show(Reading);reading_x=0;reading_y=0;return;}
+ if(panel==Reading) {
+  if(b==Left) reading_x=std::max(0,reading_x-36);
+  if(b==Right) reading_x=std::min(reading_w/2,reading_x+36);
+  if(b==Up) reading_y=std::max(0,reading_y-24);
+  if(b==Down) reading_y=std::min(reading_h-reading_view_h,reading_y+24);
+  if(b==A || b==B || b==Menu) close_panel();
+  return;
+ }
+ if(panel==Closed) {
+  if(b<=Right) return;
+  if(b==Y) show(Actions);
+  else if(b==Menu) show(Help);
+  else if(b==Select && held[L2]) { l2_chord=true; show(Keyboard); }
+  else pending.push_back(b);
+  return;
+ }
+ if(panel==Help) { if(b==A || b==B || b==Menu) close_panel(); return; }
+ if(panel==Actions) {
+  const int n=int(visible.size())+1;
+  if(b==Up) cursor=(cursor+n-1)%n;
+  if(b==Down) cursor=(cursor+1)%n;
+  if(b==Left || b==L) cursor=std::max(0,cursor-10);
+  if(b==Right || b==R) cursor=std::min(n-1,cursor+10);
+  if(b==B || b==Y || b==Menu) close_panel();
+  if(b==A) {
+   if(cursor==int(visible.size())) show(Keyboard);
+   else { selected.push_back(entries[size_t(visible[size_t(cursor)])].id); close_panel(); }
+  }
+  return;
+ }
+ if(panel==Keyboard) {
+  const int n=int(letters.size())+4;
+  if(b==Left) cursor=(cursor+n-1)%n;
+  if(b==Right) cursor=(cursor+1)%n;
+  if(b==Up) cursor=(cursor+n-Columns)%n;
+  if(b==Down) cursor=(cursor+Columns)%n;
+  if(b==A) accept_key();
+  if(b==X) { tap(SDLK_BACKSPACE); if(!text_preview.empty()) text_preview.pop_back(); }
+  if(b==Y) uppercase=!uppercase;
+  if(b==L || b==R) { keyboard_page=1-keyboard_page; letters=layouts[size_t(keyboard_page)]; cursor=0; }
+  if(b==Start) { tap(SDLK_RETURN); close_panel(); }
+  if((b==B || b==Menu) && (!text_mode || may_cancel)) { tap(SDLK_ESCAPE); close_panel(); }
+ }
+}
+void button(Button b,bool down) {
+ if(held[size_t(b)]==down) return;
+ held[size_t(b)]=down;
+ if(b<=Right && !down) last_menu_direction.clear();
+ if(b<=Right && down && menu_context && panel==Closed) queued_menu_direction=held_direction();
+ // Defer L2 until release so L2+SELECT never also selects a game target.
+ if(b==L2 && panel==Closed) {
+  if(down) {l2_chord=false;return;}
+  if(!l2_chord) press(L2);
+  l2_chord=false;return;
+ }
+ if(b<=Right && panel==Closed) key(direction(b),down);
+ if(down) { press(b); repeat_at[size_t(b)]=SDL_GetTicks()+300; }
+}
+void rect(SDL_Renderer* r,int x,int y,int w,int h,SDL_Color c) {
+ SDL_SetRenderDrawColor(r,c.r,c.g,c.b,c.a); SDL_Rect d{x,y,w,h}; SDL_RenderFillRect(r,&d);
+}
+void label(SDL_Renderer* r,const std::string& value,int x,int y,SDL_Color color={236,232,218,255}) {
+ if(!font || value.empty()) return;
+ SDL_Surface* s=TTF_RenderUTF8_Blended(font,value.c_str(),color);
+ if(!s) return;
+ SDL_Texture* t=SDL_CreateTextureFromSurface(r,s); SDL_Rect d{x,y,s->w,s->h};
+ SDL_FreeSurface(s); if(t) { SDL_RenderCopy(r,t,nullptr,&d); SDL_DestroyTexture(t); }
+}
+}
+bool enabled() { const char* p=std::getenv("ELONA_HANDHELD"); return !p || std::strcmp(p,"0")!=0; }
+bool modal() { return enabled() && panel!=Closed; }
+void commands(std::vector<Command> list) {
+ const std::vector<std::string> order={"escape","cancel","enter","save","quicksave","quick_inventory","inventory","wear","chara_info","cast","skill","get","drop","eat","drink","read","use","zap","throw","target","fire","interact","look","rest","wait","next_page","previous_page","next_menu","previous_menu","switch_mode","switch_mode_2","identify","portrait"};
+ auto rank=[&](const Command& c) {
+  const auto it=std::find(order.begin(),order.end(),c.id);
+  if(it!=order.end()) return int(it-order.begin());
+  if(c.id.find("select_")==0) return 80;
+  if(c.id.find("shortcut_")==0) return 90;
+  if(c.id.find("wizard_")==0) return 110;
+  if(c.id=="north"||c.id=="south"||c.id=="east"||c.id=="west"||c.id=="northwest"||c.id=="northeast"||c.id=="southwest"||c.id=="southeast")return 100;
+  return 50;
+ };
+ std::stable_sort(list.begin(),list.end(),[&](const Command& a,const Command& b){return rank(a)<rank(b);});
+ entries=std::move(list);
+}
+void initialize() {
+ if(!enabled()) return;
+#ifdef __linux__
+ const char* driver=SDL_GetCurrentVideoDriver();
+ if(driver && std::strcmp(driver,"mali")==0) {
+  for(int i=0;i<16;++i) {
+   const std::string path="/dev/input/event"+std::to_string(i);
+   int fd=open(path.c_str(),O_RDONLY|O_NONBLOCK|O_CLOEXEC);
+   if(fd<0) continue;
+   char name[128]{}; ioctl(fd,EVIOCGNAME(sizeof(name)),name);
+   if(std::strstr(name,"ANBERNIC-keys")) devices.push_back(fd); else ::close(fd);
+  }
+ }
+#endif
+ if(devices.empty() && SDL_NumJoysticks()>0) joystick=SDL_JoystickOpen(0);
+ const char* f=std::getenv("ELONA_PAD_FONT");
+ font=TTF_OpenFont(f?f:"data/font/GenShinGothic-Monospace-Regular.ttf",22);
+ hint_font=TTF_OpenFont(f?f:"data/font/GenShinGothic-Monospace-Regular.ttf",12);
+}
+void poll() {
+ if(!enabled()) return;
+ for(auto k:release_next) key(k,false);
+ release_next.clear();
+#ifdef __linux__
+ for(int fd:devices) {
+  input_event e{};
+  while(read(fd,&e,sizeof(e))==sizeof(e)) {
+   if(e.type==EV_SYN && e.code==SYN_DROPPED) {
+    stop_directions();held.fill(false);pending.clear();l2_chord=false;continue;
+   }
+   if(e.type==EV_KEY && e.value!=2) { auto it=evdev.find(e.code); if(it!=evdev.end()) button(it->second,e.value!=0); }
+   if(e.type==EV_ABS && e.code==ABS_HAT0X) { button(Left,e.value<0); button(Right,e.value>0); }
+   if(e.type==EV_ABS && e.code==ABS_HAT0Y) { button(Up,e.value<0); button(Down,e.value>0); }
+  }
+ }
+#endif
+ if(panel!=Closed) for(int i=Up;i<=Right;++i) if(held[size_t(i)] && Sint32(SDL_GetTicks()-repeat_at[size_t(i)])>=0) { press(static_cast<Button>(i)); repeat_at[size_t(i)]=SDL_GetTicks()+100; }
+}
+bool handle(const SDL_Event& e) {
+ if(!enabled()) return false;
+ if(e.type==SDL_WINDOWEVENT && e.window.event==SDL_WINDOWEVENT_FOCUS_LOST) {
+  stop_directions();held.fill(false);pending.clear();selected.clear();l2_chord=false;
+  for(auto k:release_next) key(k,false);release_next.clear();
+ }
+ if(e.type==SDL_JOYBUTTONDOWN || e.type==SDL_JOYBUTTONUP) {
+  if(devices.empty()) { auto it=sdlbuttons.find(e.jbutton.button); if(it!=sdlbuttons.end()) button(it->second,e.type==SDL_JOYBUTTONDOWN); }
+  return true;
+ }
+ if(e.type==SDL_JOYHATMOTION) {
+  if(devices.empty()) { button(Up,e.jhat.value&SDL_HAT_UP);button(Down,e.jhat.value&SDL_HAT_DOWN);button(Left,e.jhat.value&SDL_HAT_LEFT);button(Right,e.jhat.value&SDL_HAT_RIGHT); }
+  return true;
+ }
+ if(e.type==SDL_KEYDOWN && !e.key.repeat) {
+  if(e.key.keysym.sym==SDLK_F9) { show(Reading);reading_x=0;reading_y=0;return true; }
+  if(e.key.keysym.sym==SDLK_F8) { show(Actions); return true; }
+  if(e.key.keysym.sym==SDLK_F7) { show(Keyboard); return true; }
+  if(e.key.keysym.sym==SDLK_F10) { show(Help); return true; }
+  // Keyboard navigation is also useful for reproducible desktop smoke tests.
+  if(panel!=Closed) {
+   switch(e.key.keysym.sym) {
+    case SDLK_UP:press(Up);return true;case SDLK_DOWN:press(Down);return true;
+    case SDLK_LEFT:press(Left);return true;case SDLK_RIGHT:press(Right);return true;
+    case SDLK_RETURN:press(A);return true;case SDLK_ESCAPE:press(B);return true;
+    default:break;
+   }
+  }
+ }
+ return false;
+}
+std::string action(bool menu) {
+ menu_context=menu;
+ if(!enabled() || modal()) return "";
+ if(!menu) {last_menu_direction.clear();queued_menu_direction.clear();}
+ if(!selected.empty()) { auto s=selected.front(); selected.pop_front(); return s; }
+ if(pending.empty()) {
+  if(!menu) return "";
+  if(!queued_menu_direction.empty()) {
+   const auto move=queued_menu_direction;queued_menu_direction.clear();
+   last_menu_direction=move;menu_repeat_at=SDL_GetTicks()+350;return move;
+  }
+  const auto move=held_direction();
+  if(move.empty()) {last_menu_direction.clear();return "";}
+  const auto now=SDL_GetTicks();
+  if(move!=last_menu_direction) {
+   last_menu_direction=move;menu_repeat_at=now+350;return move;
+  }
+  if(Sint32(now-menu_repeat_at)>=0) {menu_repeat_at=now+110;return move;}
+  // Suppress the corresponding synthetic keyboard movement while waiting.
+  return "__held_direction";
+ }
+ queued_menu_direction.clear();
+ const Button b=pending.front(); pending.pop_front();
+ switch(b) {
+ case A:return "enter";
+ case B:case Start:return "escape";
+ case X:return menu?"switch_mode":"quick_inventory";
+ case L:return menu?"previous_page":"wait";
+ case R:return menu?"next_page":"get";
+ case Select:return menu?"identify":"look";
+ case L2:return menu?"previous_menu":"target";
+ case R2:return menu?"next_menu":"fire";
+ default:return "";
+ }
+}
+void begin_text(int limit,bool cancelable) {
+ if(!enabled()) return;
+ pending.clear(); selected.clear(); text_mode=true; may_cancel=cancelable; max_length=std::max(1,limit);text_preview.clear();show(Keyboard);
+}
+void end_text() { if(enabled()) { text_mode=false;close_panel();pending.clear(); } }
+void reset_view(bool menu) {
+ scene_view={0,0,720,480}; context_hint.clear(); menu_context=menu;
+}
+void menu_window(int x,int y,int width,int height) {
+ scene_view={std::max(0,x-8),std::max(0,y-12),width+16,height+20};
